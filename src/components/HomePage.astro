---
import { getCollection } from 'astro:content';
import { groupPostsBySlug, resolvePost } from '../utils/blog';
import type { Locale, Translations } from '../i18n';

interface Props {
    t: Translations;
    lang: Locale;
}

const { t, lang } = Astro.props;

const allPosts = await getCollection('blog');
const latestPosts = [...groupPostsBySlug(allPosts).values()]
    .map(group => resolvePost(group, lang))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 3);

const indexLinks = [
    { num: '01', href: `/${lang}/projects/`, ...t.home.navCards.projects },
    { num: '02', href: `/${lang}/blog/`, ...t.home.navCards.blog },
    { num: '03', href: `/${lang}/about/`, ...t.home.navCards.about },
];
---

<div class="home">
    <section class="card">
        <div class="card__glow" aria-hidden="true"></div>

        <div class="card__inner">
            <div class="card__photo-ring">
                <img
                    src="/julio-huerta.jpg"
                    alt={t.about.photoAlt}
                    class="card__photo"
                    width="160"
                    height="160"
                />
            </div>

            <h1 class="card__name home__name">JULIO HUERTA MEDINA</h1>
            <p class="card__role">{t.home.role}</p>
            <p class="card__location">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                </svg>
                {t.home.location}
            </p>

            <div class="card__bio">
                <p>{t.about.paragraphs[0]}</p>
            </div>

            <a href={`/cv/julio-huerta-cv-${lang === 'en' ? 'en' : 'es'}.pdf`} class="card__cv" download>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                {t.home.cvDownload}
            </a>
        </div>
    </section>

    <div class="home__below">
        <nav class="home-index" aria-label={t.a11y.sectionsNav}>
            {indexLinks.map(link => (
                <a href={link.href} class="home-index__row">
                    <span class="home-index__num" aria-hidden="true">{link.num}</span>
                    <span class="home-index__text">
                        <span class="home-index__title">{link.title}</span>
                        <span class="home-index__desc">{link.description}</span>
                    </span>
                    <span class="home-index__arrow" aria-hidden="true">→</span>
                </a>
            ))}
        </nav>

        {latestPosts.length > 0 && (
            <section class="home-latest">
                <h2 class="home-latest__eyebrow">{t.home.latestTitle}</h2>
                <ul class="home-latest__list">
                    {latestPosts.map(post => (
                        <li>
                            <a href={`/${lang}/blog/${post.data.canonicalSlug || post.id}/`} class="home-latest__post">
                                <time class="home-latest__date" datetime={post.data.date.toISOString()}>
                                    {post.data.date.toLocaleDateString(lang, { day: '2-digit', month: 'short', year: 'numeric' })}
                                </time>
                                <span class="home-latest__post-title">{post.data.title}</span>
                            </a>
                        </li>
                    ))}
                </ul>
                <a href={`/${lang}/blog/`} class="home-latest__all">{t.home.latestAll} →</a>
            </section>
        )}

        <section class="home-contact">
            <h2 class="home-contact__hook">{t.home.contactHook}</h2>
            <a href="mailto:hola@juhume.com" class="home-contact__email">hola@juhume.com</a>
        </section>
    </div>
</div>

<style>
    /* ==========================================
       Card Container
       ========================================== */
    .card {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: max(88svh, 36rem);
        padding: calc(3.5rem + var(--space-md)) var(--space-md) var(--space-lg);
    }

    .card__inner {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 560px;
        gap: 0;
        z-index: 1;
    }

    /* ==========================================
       Ambient Glow
       ========================================== */
    .card__glow {
        position: absolute;
        top: var(--glow-y, 50%);
        left: var(--glow-x, 50%);
        transform: translate(-50%, -55%);
        width: 550px;
        height: 550px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--accent) 8%, transparent) 0%,
            color-mix(in srgb, var(--gold) 4%, transparent) 40%,
            transparent 70%
        );
        pointer-events: none;
        z-index: 0;
        filter: blur(40px);
        will-change: transform;
    }

    :global([data-theme="dark"]) .card__glow {
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--accent) 12%, transparent) 0%,
            color-mix(in srgb, var(--accent) 5%, transparent) 40%,
            transparent 70%
        );
    }

    /* ==========================================
       Photo with gradient ring
       ========================================== */
    .card__photo-ring {
        position: relative;
        padding: 3px;
        border-radius: 30% 70% 53% 47% / 52% 35% 65% 48%;
        background: linear-gradient(135deg, var(--accent), var(--gold), var(--accent));
        margin-bottom: var(--space-lg);
        transition: border-radius 0.6s ease, box-shadow 0.6s ease;
        box-shadow: 0 8px 32px color-mix(in srgb, var(--accent) 15%, transparent);
    }

    .card__photo-ring:hover {
        border-radius: 58% 42% 36% 64% / 43% 68% 32% 57%;
        box-shadow: 0 12px 40px color-mix(in srgb, var(--accent) 25%, transparent);
    }

    .card__photo {
        width: 140px;
        height: 140px;
        border-radius: inherit;
        object-fit: cover;
        display: block;
        border: 3px solid var(--bg-primary);
        flex-shrink: 0;
    }

    :global(.js) .card__photo-ring {
        opacity: 0;
        animation: springScale 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s forwards;
    }

    /* ==========================================
       Name
       ========================================== */
    .card__name {
        font-family: 'Vila Morena', var(--font-display);
        font-size: clamp(2rem, 5vw, 3.2rem);
        font-weight: normal;
        color: var(--text-primary);
        line-height: 1.15;
        letter-spacing: 0.02em;
        margin-bottom: 0.35rem;
        overflow-wrap: normal;
        word-break: keep-all;
    }

    :global(.js) .card__name {
        opacity: 0;
        animation: springIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.35s forwards;
    }

    /* ==========================================
       Role
       ========================================== */
    .card__role {
        font-size: var(--text-base);
        color: var(--accent-text);
        font-weight: 500;
        margin-bottom: var(--space-sm);
    }

    :global(.js) .card__role {
        opacity: 0;
        animation: springIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
    }

    /* ==========================================
       Location
       ========================================== */
    .card__location {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: var(--text-xs);
        font-weight: 500;
        letter-spacing: 0.03em;
        color: var(--text-muted);
        margin-bottom: var(--space-sm);
    }

    :global(.js) .card__location {
        opacity: 0;
        animation: springIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s forwards;
    }

    /* ==========================================
       Proof Badges
       ========================================== */
    .card__proofs {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-xs);
        margin-bottom: var(--space-lg);
    }

    .card__proof {
        font-size: 0.72rem;
        font-weight: 500;
        padding: 0.3rem 0.75rem;
        border-radius: 100px;
        border: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg-secondary) 60%, transparent);
        color: var(--text-secondary);
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    :global(.js) .card__proofs {
        opacity: 0;
        animation: springIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.65s forwards;
    }

    /* ==========================================
       Live Homelab Badge
       ========================================== */
    .card__live {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: var(--space-md);
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--accent-text);
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .card__live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent-text);
        box-shadow: 0 0 6px var(--accent);
        animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
        0%, 100% { opacity: 1; box-shadow: 0 0 6px var(--accent); }
        50% { opacity: 0.5; box-shadow: 0 0 12px var(--accent); }
    }

    :global(.js) .card__live {
        opacity: 0;
        animation: springIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.75s forwards;
    }

    /* ==========================================
       Bio
       ========================================== */
    .card__bio {
        margin-bottom: var(--space-sm);
    }

    .card__bio p {
        font-size: var(--text-base);
        color: var(--text-secondary);
        line-height: 1.75;
        max-width: 48ch;
        margin: 0 auto var(--space-xs);
    }

    .card__bio p:last-child {
        margin-bottom: 0;
    }

    :global(.js) .card__bio {
        opacity: 0;
        animation: springIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.85s forwards;
    }

    /* Bio Shimmer Effect */
    @keyframes textShimmer {
        0% { background-position: -100% 0; }
        100% { background-position: 200% 0; }
    }

    .card__bio--shimmer p {
        background: linear-gradient(
            90deg,
            var(--text-secondary) 0%,
            var(--text-secondary) 40%,
            var(--accent-text) 50%,
            var(--text-secondary) 60%,
            var(--text-secondary) 100%
        );
        background-size: 200% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: textShimmer 1.5s ease-in-out 1.6s forwards;
    }

/* ==========================================
       CV Download Link
       ========================================== */
    .card__cv {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.5rem 1rem;
        border: 1px solid var(--border);
        border-radius: 100px;
        transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
    }
    .card__cv:hover {
        color: var(--accent-text);
        border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    }
    :global(.js) .card__cv {
        opacity: 0;
        animation: springIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.05s forwards;
    }

    /* ==========================================
       Below the fold: index + latest + contact
       ========================================== */
    .home__below {
        max-width: 640px;
        margin: 0 auto;
        padding: 0 var(--space-md) var(--space-2xl);
    }

    :global(.js) .home__below {
        opacity: 0;
        animation: fadeUp 0.8s var(--ease-out) 1.15s forwards;
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* --- Section index --- */
    .home-index {
        display: flex;
        flex-direction: column;
    }

    .home-index__row {
        display: grid;
        grid-template-columns: 2.6rem 1fr auto;
        align-items: center;
        gap: var(--space-sm);
        padding: 1.3rem 0;
        border-top: 1px solid var(--border);
        text-decoration: none;
    }

    .home-index__row:last-child {
        border-bottom: 1px solid var(--border);
    }

    .home-index__num {
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--accent-text);
        font-variant-numeric: tabular-nums;
    }

    .home-index__text {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
    }

    .home-index__title {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 3.5vw, 2rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.15;
        color: var(--text-primary);
        transition: transform var(--duration-normal) var(--ease-out),
                    color var(--duration-fast) ease;
    }

    .home-index__desc {
        font-size: var(--text-sm);
        color: var(--text-muted);
    }

    .home-index__arrow {
        font-size: 1.3rem;
        color: var(--accent-text);
        opacity: 0;
        transform: translateX(-8px);
        transition: opacity var(--duration-normal) var(--ease-out),
                    transform var(--duration-normal) var(--ease-out);
    }

    @media (hover: hover) {
        .home-index__row:hover .home-index__title {
            transform: translateX(6px);
            color: var(--accent-text);
        }
        .home-index__row:hover .home-index__arrow {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .home-index__row:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
        border-radius: 4px;
    }

    /* --- Latest posts --- */
    .home-latest {
        margin-top: var(--space-2xl);
    }

    .home-latest__eyebrow,
    .home-contact__hook {
        font-size: var(--text-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent-text);
        margin-bottom: var(--space-sm);
    }

    .home-latest__list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .home-latest__post {
        display: flex;
        align-items: baseline;
        gap: var(--space-sm);
        padding: 0.7rem 0;
        border-top: 1px solid var(--border);
        text-decoration: none;
    }

    .home-latest__list li:last-child .home-latest__post {
        border-bottom: 1px solid var(--border);
    }

    .home-latest__date {
        flex-shrink: 0;
        width: 6.2rem;
        font-size: var(--text-xs);
        color: var(--text-muted);
        font-variant-numeric: tabular-nums;
    }

    .home-latest__post-title {
        font-size: var(--text-base);
        font-weight: 500;
        color: var(--text-secondary);
        line-height: 1.45;
        transition: color var(--duration-fast) ease;
    }

    @media (hover: hover) {
        .home-latest__post:hover .home-latest__post-title {
            color: var(--accent-text);
        }
    }

    .home-latest__all {
        display: inline-block;
        margin-top: var(--space-sm);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
        transition: color var(--duration-fast) ease;
    }

    .home-latest__all:hover {
        color: var(--accent-text);
    }

    /* --- Contact --- */
    .home-contact {
        margin-top: var(--space-2xl);
    }

    .home-contact__email {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        color: var(--text-primary);
        text-decoration: none;
        background-image: linear-gradient(var(--accent), var(--accent));
        background-size: 0% 3px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        transition: background-size 0.4s var(--ease-out), color var(--duration-fast) ease;
        padding-bottom: 4px;
    }

    @media (hover: hover) {
        .home-contact__email:hover {
            background-size: 100% 3px;
            color: var(--accent-text);
        }
    }

    @media (max-width: 480px) {
        .home-index__row {
            grid-template-columns: 2.2rem 1fr auto;
            padding: 1rem 0;
        }

        .home-latest__post {
            flex-direction: column;
            gap: 0.15rem;
        }

        .home-latest__date {
            width: auto;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.js) .home__below {
            animation: none;
            opacity: 1;
        }
    }

    /* ==========================================
       Animations
       ========================================== */
    @keyframes springIn {
        0% { opacity: 0; transform: translateY(20px) scale(0.97); }
        60% { opacity: 1; transform: translateY(-3px) scale(1.01); }
        80% { transform: translateY(1px) scale(0.995); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes springScale {
        0% { opacity: 0; transform: scale(0.8); }
        60% { opacity: 1; transform: scale(1.05); }
        80% { transform: scale(0.98); }
        100% { opacity: 1; transform: scale(1); }
    }

    /* ==========================================
       Responsive
       ========================================== */
    @media (max-width: 480px) {
        .card {
            padding: calc(3.5rem + var(--space-sm)) var(--space-sm) var(--space-md);
            min-height: max(82svh, 32rem);
        }

        .card__glow {
            width: 320px;
            height: 320px;
        }

        .card__photo-ring {
            margin-bottom: var(--space-md);
        }

        .card__photo {
            width: 110px;
            height: 110px;
        }

        .card__name {
            font-size: clamp(1.6rem, 6vw, 2.2rem);
        }

        .card__role {
            font-size: 0.85rem;
        }

        .card__proofs {
            margin-bottom: var(--space-md);
        }

        .card__proof {
            font-size: 0.65rem;
            padding: 0.25rem 0.6rem;
        }

        .card__bio p {
            font-size: 0.875rem;
        }

        .card__tagline {
            font-size: 0.8rem;
            margin-bottom: var(--space-lg);
        }

    }

    @media (min-width: 768px) {
        .card__photo {
            width: 170px;
            height: 170px;
        }

        .card__photo-ring {
            padding: 3.5px;
        }

    }
</style>
