---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getTranslations, getSectionIds, locales } from '../i18n';
import type { Locale } from '../i18n';

const lang: Locale = 'es';
const t = getTranslations(lang);
const ids = getSectionIds(lang);

// Prepare all locale translations for client-side language detection
const allNotFound = Object.fromEntries(
    locales.map((loc) => {
        const tr = getTranslations(loc);
        return [loc, {
            text: tr.notFound.text,
            backHome: tr.notFound.backHome,
            hint: tr.notFound.hint,
            nav: {
                projects: tr.nav.projects,
                about: tr.nav.about,
                blog: tr.nav.blog,
            },
        }];
    })
);
---

<BaseLayout
    lang={lang}
    t={t}
    title={`404 | juhume`}
    description={t.notFound.text}
    noindex={true}
>
    <Header lang={lang} t={t} ids={ids} currentPath="/404" />

    <section class="not-found">
        <div class="not-found__glow" aria-hidden="true"></div>
        <div class="container not-found__container">
            <h1 class="not-found__title" aria-label="404">
                <span class="not-found__digit" aria-hidden="true">4</span><span
                    class="not-found__octo octo"
                    aria-hidden="true">🐙</span><span
                    class="not-found__digit not-found__digit--last"
                    aria-hidden="true">4</span>
            </h1>
            <p class="not-found__text" id="nf-text">{t.notFound.text}</p>
            <a href={`/${lang}/`} class="not-found__link" id="nf-link">← {t.notFound.backHome}</a>
            <p class="not-found__hint" id="nf-hint">
                <a href="mailto:hola@juhume.com" class="not-found__hint-link">{t.notFound.hint}</a>
            </p>
        </div>
    </section>

    <Footer t={t} />
</BaseLayout>

<style>
    .not-found {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 88svh;
        padding: calc(3.5rem + var(--space-md)) var(--space-md) var(--space-xl);
        text-align: center;
        overflow: hidden;
    }

    .not-found__glow {
        position: absolute;
        top: 45%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 560px;
        height: 560px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            color-mix(in srgb, var(--accent) 9%, transparent) 0%,
            color-mix(in srgb, var(--gold) 4%, transparent) 45%,
            transparent 70%
        );
        filter: blur(40px);
        pointer-events: none;
    }

    .not-found__container {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* --- 404 con el pulpo de cero --- */
    .not-found__title {
        font-family: 'Vila Morena', var(--font-display);
        font-size: clamp(6rem, 22vw, 13rem);
        font-weight: normal;
        line-height: 1;
        color: var(--text-primary);
        letter-spacing: 0.04em;
        display: flex;
        align-items: center;
        gap: 0.05em;
        margin-bottom: var(--space-md);
    }

    .not-found__octo {
        font-size: 0.62em;
        line-height: 1;
        animation: octo-float 4s ease-in-out infinite;
        transform-origin: 50% 40%;
    }

    @keyframes octo-float {
        0%, 100% { transform: translateY(0) rotate(-4deg); }
        50% { transform: translateY(-0.08em) rotate(5deg); }
    }

    :global(.js) .not-found__digit,
    :global(.js) .not-found__octo {
        opacity: 0;
        animation-fill-mode: forwards;
    }

    :global(.js) .not-found__digit {
        animation: nf-spring 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s forwards;
    }

    :global(.js) .not-found__octo {
        animation:
            nf-spring 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards,
            octo-float 4s ease-in-out 1.1s infinite;
    }

    :global(.js) .not-found__digit--last {
        animation-delay: 0.5s;
    }

    @keyframes nf-spring {
        0% { opacity: 0; transform: translateY(24px) scale(0.85); }
        60% { opacity: 1; transform: translateY(-4px) scale(1.03); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* --- Textos --- */
    .not-found__text {
        font-size: var(--text-md);
        color: var(--text-secondary);
        max-width: 34ch;
        margin: 0 auto var(--space-lg);
        text-wrap: balance;
    }

    :global(.js) .not-found__text {
        opacity: 0;
        animation: nf-fade 0.6s var(--ease-out) 0.7s forwards;
    }

    /* --- Acciones --- */
    .not-found__link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0.75rem 1.5rem;
        background: var(--accent);
        color: var(--on-accent);
        border-radius: 100px;
        font-size: 0.875rem;
        font-weight: 600;
        transition: background var(--duration-fast) ease, transform var(--duration-fast) var(--ease-bounce);
    }

    @media (hover: hover) {
        .not-found__link:hover {
            background: var(--accent-hover);
            transform: translateY(-2px);
        }
    }

    .not-found__link:active {
        transform: scale(0.97);
    }

    :global(.js) .not-found__link {
        opacity: 0;
        animation: nf-fade 0.6s var(--ease-out) 0.85s forwards;
    }

    .not-found__hint {
        margin-top: var(--space-lg);
        font-size: var(--text-sm);
    }

    .not-found__hint-link {
        color: var(--text-muted);
        background-image: linear-gradient(var(--accent), var(--accent));
        background-size: 0% 1.5px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        padding-bottom: 2px;
        transition: color var(--duration-fast) ease, background-size 0.3s var(--ease-out);
    }

    @media (hover: hover) {
        .not-found__hint-link:hover {
            color: var(--accent-text);
            background-size: 100% 1.5px;
        }
    }

    :global(.js) .not-found__hint {
        opacity: 0;
        animation: nf-fade 0.6s var(--ease-out) 1s forwards;
    }

    @keyframes nf-fade {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.js) .not-found__digit,
        :global(.js) .not-found__octo,
        :global(.js) .not-found__text,
        :global(.js) .not-found__link,
        :global(.js) .not-found__hint {
            animation: none;
            opacity: 1;
        }
    }
</style>

<script define:vars={{ allNotFound, locales }}>
    (function () {
        const path = window.location.pathname;
        const segment = path.split('/')[1];
        const detectedLang = locales.includes(segment) ? segment : 'es';

        // El switcher de idioma genera /xx/404/, una ruta que no existe:
        // en la 404 siempre debe llevar a la home de cada idioma
        document.querySelectorAll('.lang-switcher__link').forEach((link) => {
            const code = (link.textContent || '').trim().toLowerCase();
            if (!locales.includes(code)) return;
            link.href = '/' + code + '/';
            link.classList.toggle('active', code === detectedLang);
        });

        if (detectedLang === 'es') return;

        const tr = allNotFound[detectedLang];
        document.documentElement.lang = detectedLang;

        const textEl = document.getElementById('nf-text');
        const linkEl = document.getElementById('nf-link');
        const hintEl = document.querySelector('#nf-hint .not-found__hint-link');

        if (textEl) textEl.textContent = tr.text;
        if (linkEl) {
            linkEl.textContent = '← ' + tr.backHome;
            linkEl.href = '/' + detectedLang + '/';
        }
        if (hintEl) hintEl.textContent = tr.hint;

        // Header y menú móvil: el 404 se renderiza con lang=es fijo, así que
        // hay que traducir etiquetas y reescribir los href al idioma detectado
        const navLabels = {
            ['/es/projects/']: tr.nav.projects,
            ['/es/about/']: tr.nav.about,
            ['/es/blog/']: tr.nav.blog,
        };
        document.querySelectorAll('.nav__link, .mobile-menu__link').forEach((link) => {
            const href = link.getAttribute('href');
            if (navLabels[href]) link.textContent = navLabels[href];
            if (href && href.startsWith('/es/')) {
                link.setAttribute('href', href.replace('/es/', '/' + detectedLang + '/'));
            }
        });
        const logo = document.querySelector('.nav__logo');
        if (logo) logo.setAttribute('href', '/' + detectedLang + '/');
    })();
</script>
