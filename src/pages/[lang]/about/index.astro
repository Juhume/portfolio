---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Footer from '../../../components/Footer.astro';
import { locales, getTranslations, getSectionIds } from '../../../i18n';
import type { Locale } from '../../../i18n';

export function getStaticPaths() {
    return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getTranslations(lang);
const ids = getSectionIds(lang);
const canonicalPath = `/${lang}/about/`;

// Easter egg: la palabra "Habbo" esconde un personajillo pixel-art
const habboEgg =
    '<span class="habbo-egg" tabindex="0">Habbo<span class="habbo-egg__tip" aria-hidden="true"><span class="habbo-egg__px"></span><em>¡Bobba!</em></span></span>';
const personalWithEgg = t.about.personal.map(p => p.replace('Habbo', habboEgg));
---

<BaseLayout
    lang={lang}
    t={t}
    title={`${t.about.title} | juhume`}
    description={t.meta.description}
    canonicalPath={canonicalPath}
>
    <Header lang={lang} t={t} ids={ids} currentPath={Astro.url.pathname} />

    <div class="about-page">
        <div class="container">
            <Breadcrumb items={[
                { label: t.nav.home || (lang === 'en' ? 'Home' : 'Inicio'), href: `/${lang}/` },
                { label: t.about.title }
            ]} />
        </div>

        <div class="container about-page__content">
            <header class="print-header">
                <strong class="print-header__name">Julio Huerta Medina</strong>
                <span class="print-header__meta">{t.meta.jobTitle} · hola@juhume.com · juhume.com · linkedin.com/in/juhume</span>
            </header>

            <div class="about-page__hero">
                <h1 class="about-page__title">{t.about.title}</h1>
                <p class="about-page__location">{t.home.location}</p>
                <div class="about-page__actions">
                    <a href={`/cv/julio-huerta-cv-${lang === 'en' ? 'en' : 'es'}.pdf`} class="about-page__action about-page__action--cv" download>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        {t.home.cvDownload}
                    </a>
                    <a href="https://github.com/juhume" target="_blank" rel="noopener noreferrer" class="about-page__action">GitHub ↗</a>
                    <a href="https://linkedin.com/in/juhume" target="_blank" rel="noopener noreferrer" class="about-page__action">LinkedIn ↗</a>
                    <a href="mailto:hola@juhume.com" class="about-page__action">hola@juhume.com</a>
                </div>
            </div>

            <div class="about-page__bio">
                {t.about.paragraphs.map(p => <p>{p}</p>)}
            </div>

            <section class="about-page__section">
                <h2 class="about-page__section-title">{t.experience.title}</h2>
                <ol class="exp">
                    {t.experience.entries.map(entry => (
                        <li class="exp__item">
                            <span class="exp__period">{entry.period}</span>
                            <div class="exp__body">
                                <h3 class="exp__role">{entry.role}</h3>
                                <p class="exp__context">{entry.context}</p>
                                <div class="exp__stack">
                                    {entry.stack.map(tech => <span class="exp__tag">{tech}</span>)}
                                </div>
                            </div>
                        </li>
                    ))}
                </ol>
            </section>

            <section class="about-page__section">
                <h2 class="about-page__section-title">{t.about.personalTitle}</h2>
                {personalWithEgg.map((p, i) => (
                    <>
                        <p set:html={p} />
                        {i === 0 && (
                            <aside
                                class="now-playing"
                                id="nowPlaying"
                                data-label-playing={t.about.nowPlaying}
                                data-label-last={t.about.lastPlayed}
                                hidden
                            >
                                <span class="now-playing__bars" aria-hidden="true"><i></i><i></i><i></i></span>
                                <span class="now-playing__label" id="npLabel"></span>
                                <a class="now-playing__track" id="npTrack" target="_blank" rel="noopener noreferrer"></a>
                            </aside>
                        )}
                    </>
                ))}
            </section>

            <section class="about-page__section">
                <h2 class="about-page__section-title">{t.about.principlesTitle}</h2>
                <ul class="about-page__principles">
                    {t.about.principles.map(p => <li>{p}</li>)}
                </ul>
            </section>

            <section class="about-page__section about-cta">
                <p class="about-cta__text">{t.contact.text}</p>
                <div class="about-cta__actions">
                    <a href="mailto:hola@juhume.com" class="about-cta__primary">{t.contact.cta}</a>
                    <a href={`/${lang}/projects/`} class="about-cta__secondary">{t.nav.projects} →</a>
                </div>
            </section>
        </div>
    </div>

    <Footer t={t} />
</BaseLayout>

<style>
.about-page {
    padding-top: calc(3.5rem + 1rem);
}

.about-page__content {
    max-width: 680px;
    margin: 0 auto;
}

.about-page__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--space-xl);
}

.about-page__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
}

.about-page__location {
    margin-top: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-muted);
}

/* --- Acciones de cabecera (CV + enlaces) --- */
.about-page__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-md);
}

.about-page__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
}

.about-page__action--cv {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent-text);
    font-weight: 600;
}

@media (hover: hover) {
    .about-page__action:hover {
        color: var(--accent-text);
        border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    }
}

/* --- CTA de cierre --- */
.about-cta__text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
}

.about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
}

.about-cta__primary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.75rem 1.5rem;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 100px;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background var(--duration-fast) ease, transform var(--duration-fast) var(--ease-bounce);
}

@media (hover: hover) {
    .about-cta__primary:hover {
        background: var(--accent-hover);
        transform: translateY(-2px);
    }
}

.about-cta__secondary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--duration-fast) ease;
}

.about-cta__secondary:hover {
    color: var(--accent-text);
}

.about-page__bio {
    margin-bottom: var(--space-xl);
}

.about-page__bio p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
}

.about-page__section {
    margin-bottom: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
}

.about-page__section-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-bottom: var(--space-md);
    letter-spacing: -0.02em;
}

.about-page__section p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
}

.about-page__section :global(.about-link) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    transition: text-decoration-color 0.2s;
}

.about-page__section :global(.about-link):hover {
    text-decoration-color: var(--accent);
}

.about-page__section :global(.about-link)::after {
    content: '↗';
    position: absolute;
    top: -0.5em;
    right: -0.8em;
    font-size: 0.65em;
    opacity: 0;
    transition: opacity 0.2s;
}

.about-page__section :global(.about-link) {
    position: relative;
}

.about-page__section :global(.about-link):hover::after {
    opacity: 1;
}

/* --- Experiencia --- */
.exp {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
}

.exp__item {
    display: grid;
    gap: 0.3rem;
}

@media (min-width: 600px) {
    .exp__item {
        grid-template-columns: 130px 1fr;
        gap: var(--space-md);
    }
}

.exp__period {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
    padding-top: 0.25rem;
    white-space: nowrap;
}

.exp__role {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 0.3rem;
}

.exp__context {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
}

.exp__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}

.exp__tag {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    background: color-mix(in srgb, var(--bg-secondary) 60%, transparent);
    white-space: nowrap;
}

.about-page__principles {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
}

.about-page__principles li {
    font-size: 0.95rem;
    color: var(--text-secondary);
    padding-left: 1.2rem;
    position: relative;
}

.about-page__principles li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-text);
}

/* --- Easter egg Habbo (inyectado vía set:html, requiere :global) --- */
.about-page :global(.habbo-egg) {
    position: relative;
    border-bottom: 1px dashed color-mix(in srgb, var(--accent-text) 55%, transparent);
    cursor: help;
}

.about-page :global(.habbo-egg__tip) {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translate(-50%, 6px);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.85rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    box-shadow: 0 12px 32px var(--shadow);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out);
    z-index: 10;
}

.about-page :global(.habbo-egg:hover .habbo-egg__tip),
.about-page :global(.habbo-egg:focus-visible .habbo-egg__tip) {
    opacity: 1;
    transform: translate(-50%, 0);
}

.about-page :global(.habbo-egg__tip em) {
    font-style: normal;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
}

/* Personajillo pixel-art dibujado con box-shadow (píxeles de 3px) */
.about-page :global(.habbo-egg__px) {
    position: relative;
    width: 27px;
    height: 39px;
    flex-shrink: 0;
    animation: habbo-bob 0.9s steps(2) infinite;
}

.about-page :global(.habbo-egg__px)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 3px;
    box-shadow:
        /* pelo */
        9px 0 #4a2f1a, 12px 0 #4a2f1a, 15px 0 #4a2f1a, 18px 0 #4a2f1a,
        6px 3px #4a2f1a, 9px 3px #4a2f1a, 12px 3px #4a2f1a, 15px 3px #4a2f1a, 18px 3px #4a2f1a, 21px 3px #4a2f1a,
        /* cara */
        9px 6px #f2c79b, 12px 6px #f2c79b, 15px 6px #f2c79b, 18px 6px #f2c79b,
        9px 9px #f2c79b, 12px 9px #1d1d1d, 15px 9px #f2c79b, 18px 9px #1d1d1d,
        9px 12px #f2c79b, 12px 12px #f2c79b, 15px 12px #f2c79b, 18px 12px #f2c79b,
        /* cuello */
        12px 15px #f2c79b, 15px 15px #f2c79b,
        /* camiseta y brazos */
        6px 18px #f2c79b, 9px 18px #83deb5, 12px 18px #83deb5, 15px 18px #83deb5, 18px 18px #83deb5, 21px 18px #f2c79b,
        6px 21px #f2c79b, 9px 21px #83deb5, 12px 21px #83deb5, 15px 21px #83deb5, 18px 21px #83deb5, 21px 21px #f2c79b,
        9px 24px #83deb5, 12px 24px #83deb5, 15px 24px #83deb5, 18px 24px #83deb5,
        /* pantalón */
        9px 27px #31424d, 12px 27px #31424d, 15px 27px #31424d, 18px 27px #31424d,
        9px 30px #31424d, 12px 30px #31424d, 15px 30px #31424d, 18px 30px #31424d,
        9px 33px #31424d, 12px 33px #31424d, 15px 33px #31424d, 18px 33px #31424d,
        /* zapatos */
        6px 36px #1d1d1d, 9px 36px #1d1d1d, 12px 36px #1d1d1d,
        15px 36px #1d1d1d, 18px 36px #1d1d1d, 21px 36px #1d1d1d;
}

@keyframes habbo-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
}

@media (prefers-reduced-motion: reduce) {
    .about-page :global(.habbo-egg__px) {
        animation: none;
    }
}

/* --- Ahora suena (Spotify) --- */
.now-playing[hidden] {
    display: none;
}

.now-playing {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    max-width: 100%;
    margin: 0.25rem 0 var(--space-md);
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--bg-secondary) 55%, transparent);
}

.now-playing__bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
    flex-shrink: 0;
}

.now-playing__bars i {
    width: 3px;
    height: 6px;
    border-radius: 1px;
    background: var(--accent-text);
    opacity: 0.55;
}

.now-playing--live .now-playing__bars i {
    opacity: 1;
    animation: eq-bounce 1s ease-in-out infinite;
}

.now-playing--live .now-playing__bars i:nth-child(2) {
    animation-delay: 0.25s;
}

.now-playing--live .now-playing__bars i:nth-child(3) {
    animation-delay: 0.45s;
}

@keyframes eq-bounce {
    0%, 100% { height: 5px; }
    50% { height: 14px; }
}

@media (prefers-reduced-motion: reduce) {
    .now-playing--live .now-playing__bars i {
        animation: none;
    }
}

.now-playing__label {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    white-space: nowrap;
}

.now-playing__track {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--duration-fast) ease;
}

@media (hover: hover) {
    .now-playing__track:hover {
        color: var(--accent-text);
    }
}

/* --- CV imprimible --- */
.print-header {
    display: none;
}

@media print {
    .about-page {
        padding-top: 0;
    }

    .print-header {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        margin-bottom: 1.2rem;
        padding-bottom: 0.8rem;
        border-bottom: 2px solid #1a1a1a;
    }

    .print-header__name {
        font-size: 1.6rem;
        letter-spacing: -0.02em;
    }

    .print-header__meta {
        font-size: 0.8rem;
        color: #444;
    }

    /* La foto y el título grande sobran en papel */
    .about-page__hero {
        display: none;
    }

    .about-page__content {
        max-width: none;
    }

    .about-page__bio p,
    .about-page__section p,
    .about-page__principles li,
    .exp__context {
        color: #1a1a1a;
        font-size: 0.85rem;
        line-height: 1.55;
    }

    .about-page__bio {
        margin-bottom: 1.2rem;
    }

    .about-page__section {
        margin-bottom: 1.2rem;
        padding-top: 0.9rem;
        border-top: 1px solid #ccc;
        break-inside: avoid;
    }

    .about-page__section-title {
        font-size: 1rem;
        margin-bottom: 0.6rem;
    }

    .exp {
        gap: 0.9rem;
    }

    .exp__period {
        color: #444;
    }

    .exp__role {
        font-size: 0.95rem;
        color: #1a1a1a;
    }

    .exp__item {
        break-inside: avoid;
    }

    .exp__tag {
        border-color: #bbb;
        color: #444;
        background: none;
    }

    /* El easter egg no pinta nada en papel */
    .about-page :global(.habbo-egg) {
        border-bottom: none;
    }

    .about-page :global(.habbo-egg__tip) {
        display: none;
    }

    .now-playing,
    .about-page__actions,
    .about-cta {
        display: none;
    }
}
</style>
<script>
    function initNowPlaying() {
        const box = document.getElementById('nowPlaying');
        if (!box || box.dataset.loaded) return;
        box.dataset.loaded = '1';

        fetch('/api/now-playing')
            .then(r => (r.status === 200 ? r.json() : null))
            .then(data => {
                if (!data?.title) return;
                const label = document.getElementById('npLabel');
                const track = document.getElementById('npTrack') as HTMLAnchorElement | null;
                if (!label || !track) return;

                label.textContent = data.playing
                    ? (box.dataset.labelPlaying ?? '')
                    : (box.dataset.labelLast ?? '');
                track.textContent = `${data.title} · ${data.artist}`;
                if (data.url) track.href = data.url;
                box.classList.toggle('now-playing--live', !!data.playing);
                box.hidden = false;
            })
            .catch(() => {});
    }

    initNowPlaying();
    document.addEventListener('astro:page-load', initNowPlaying);
</script>
